# AWS Cognito (managed login, Authorization Code + PKCE). The app client must allow the callback URL
# <origin>/auth/callback, the sign-out URL <origin>/, and the scopes "openid email".
# Leave NEXT_PUBLIC_COGNITO_CLIENT_ID empty to enable the DEV AUTH BYPASS (fixed fake token; local only).
NEXT_PUBLIC_COGNITO_DOMAIN=https://your-domain-prefix.auth.us-east-1.amazoncognito.com
NEXT_PUBLIC_COGNITO_CLIENT_ID=your-app-client-id
NEXT_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
NEXT_PUBLIC_COGNITO_REGION=us-east-1
# Empty = same origin (/api/...).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# "enabled" starts the MSW mock API in the browser (set automatically by `npm run dev:mock`).
NEXT_PUBLIC_API_MOCKING=
