# Copy to backend.hcl (git-ignored) or generate it from the bootstrap:
#   (cd bootstrap && terraform output -raw backend_hcl) > backend.hcl
# then: terraform init -backend-config=backend.hcl
bucket       = "dcf-tfstate-123456789012"
key          = "dcf/prod/terraform.tfstate"
region       = "us-east-2"
encrypt      = true
use_lockfile = true
