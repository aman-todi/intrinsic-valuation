# Copy to terraform.tfvars (git-ignored) and fill in. Nothing here is secret. The owner's API keys go
# to SSM via infra/scripts/put_ssm_params.sh; the DB password is generated by Terraform (random_password)
# and written to the DATABASE_URL SecureString, so it is also in the (private, encrypted) state bucket.

aws_region   = "us-east-1"
github_owner = "aman-todi"
github_repo  = "intrinsic-valuation"
alert_email  = "you@example.com" # budget alerts + Let's Encrypt contact

# The frontend's browser origins: exact origins, https, no trailing slash. One list drives both the
# API's CORS_ORIGINS and the Cognito callback (<origin>/auth/callback) / sign-out (<origin>/) URLs.
# Empty until the Vercel project exists; then add its production URL, re-apply and redeploy the API.
frontend_origins = [
  # "https://dcf-valuation.vercel.app",
]

# Optional: auth (Cognito)
# cognito_allow_self_signup   = false # true = anyone can sign up; default invite-only (admin-create-user)
# cognito_email_otp_enabled   = true  # passwordless email codes next to the password (50 emails/day limit)
# cognito_localhost_callbacks = true  # allow http://localhost:3000 sign-in against this pool
# cognito_domain_prefix       = ""    # default <project>-<random hex>
# cognito_deletion_protection = true  # false (and apply) right before `terraform destroy`

# Optional: database (RDS PostgreSQL)
# db_engine_version        = "17"            # major only = region default minor, auto minor upgrades
# db_instance_class        = "db.t4g.micro"  # db.t4g.small (2 GB) if the DB is memory-bound
# db_allocated_storage_gb  = 20
# db_max_allocated_storage_gb = 50
# db_backup_retention_days = 7
# db_deletion_protection   = true            # false (and apply) right before `terraform destroy`

# Optional: everything else
# domain_name        = "api.example.com" # create the A record -> elastic_ip first; empty = <eip>.sslip.io
# instance_type      = "t4g.small"       # t4g.medium (4 GB) if builds get OOM-killed / swap heavily
# worker_concurrency = 2                 # 4 on t4g.medium
# monthly_budget_usd = 45
# cpu_credits        = "unlimited"       # "standard" = never billed for bursts, but throttled
# s3_bucket_name     = ""                # default <project>-app-artifacts-<account-id>
# github_oidc_provider_arn = ""          # set if the account already has the GitHub OIDC provider
# force_destroy      = false             # true (and apply) right before `terraform destroy`
