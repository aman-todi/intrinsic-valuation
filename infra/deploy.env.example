# Copy to infra/deploy.env (git-ignored) and fill in. Read by bootstrap_aws.sh, deploy.sh and
# put_ssm_params.sh. Nothing here is a secret -- secrets live in SSM Parameter Store (/dcf/prod/*).
# In GitHub Actions the same names come from repository *variables* (see docs/DEPLOYMENT.md).
# Values in this file win over variables already exported in your shell.

AWS_REGION=us-east-1
# Optional; defaults to dcf-app-artifacts-<account-id> (S3 names are global, so a bare name is likely taken).
#S3_BUCKET_NAME=dcf-app-artifacts-123456789012

# ---- runtime config baked into the ECS task definitions (plain env vars, not secrets) ----
SUPABASE_URL=https://your-project-ref.supabase.co
# Exact browser origin(s) of the frontend, comma-separated, no trailing slash.
CORS_ORIGINS=https://your-app.vercel.app
SEC_EDGAR_USER_AGENT="DCF-Valuation-App aman.todi01@gmail.com"
ANTHROPIC_MODEL=claude-sonnet-5

# ---- bootstrap only ----
# owner/repo allowed to assume the deploy role (default: parsed from `git remote get-url origin`).
#GITHUB_REPO=aman-todi/intrinsic-valuation
# HTTPS in front of the ALB:
#   cloudfront (default) - free *.cloudfront.net HTTPS URL, no domain needed
#   acm                  - HTTPS listener on the ALB; set ACM_CERT_ARN to an issued cert for your domain
#   none                 - HTTP only. A Vercel (HTTPS) frontend CANNOT call this: browsers block mixed content.
#API_HTTPS_MODE=cloudfront
#ACM_CERT_ARN=arn:aws:acm:us-east-1:123456789012:certificate/...

# ---- deploy knobs ----
# Run worker + redis on Fargate Spot (~70% cheaper; the 2-minute interruption notice matches
# stopTimeout=120). Applied only when deploy.sh first creates those services.
#USE_FARGATE_SPOT=false
#SKIP_MIGRATIONS=false
# Re-register + restart the redis service (drops queued jobs and locks). Normally off.
#DEPLOY_REDIS=false
#REDIS_IMAGE=public.ecr.aws/docker/library/redis:7-alpine
# Allow deploying from a working tree with uncommitted changes (local only).
#ALLOW_DIRTY=false
