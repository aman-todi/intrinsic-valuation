# API image (uvicorn). Built for linux/arm64 (Graviton EC2) by .github/workflows/deploy.yml and
# infra/scripts/deploy.sh; also used by the local docker-compose.yml. Migrations run from this image too
# (`alembic upgrade head`, see infra/scripts/deploy_remote.sh).
FROM python:3.13-slim AS base
WORKDIR /app
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
RUN apt-get update && apt-get install -y --no-install-recommends libpq5 curl && rm -rf /var/lib/apt/lists/*
COPY backend/pyproject.toml ./
COPY backend/app ./app
RUN pip install uv && uv pip install --system .
COPY backend/alembic.ini ./
COPY backend/alembic ./alembic
EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=3s CMD curl -f http://localhost:8000/api/health || exit 1
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
